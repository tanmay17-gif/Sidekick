# Sidekick web client configuration (placeholders only - never commit real values)

# Absolute API base URL. Leave empty to use the same origin (the dev proxy).
# VITE_SIDECKICK_API_BASE=http://127.0.0.1:8000

# Endpoint paths. Override only if the backend routes differ from the defaults.
# VITE_SIDECKICK_INTERPRET_PATH=/api/v1/requests
# VITE_SIDECKICK_CAPABILITIES_PATH=/api/v1/capabilities
# VITE_SIDECKICK_MEDIA_PATH=/api/v1/media/catalog
# VITE_SIDECKICK_ACTION_PATH=/api/v1/actions/:id

# Build/run side: where the dev proxy forwards /api/* to.
# SIDECKICK_API_TARGET=http://127.0.0.1:8000

# Port for the SIMULATED_TEST_ONLY development backend.
# SIDECKICK_STUB_PORT=8000
