# Python bytecode / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.eggs/

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/

# Local secrets -- never commit real values
.env
.env.*
!.env.example
!**/.env.example

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Node (the browser client lives in web/)
node_modules/
dist-ssr/
*.local
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# Screenshots captured by scripts/screenshots.mjs (reference material, not source)
screenshots/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Local runtime state
# The execution service writes its job store outside the repository by default.
# If a local job store is created inside the tree it is ignored here.
.sidekick-jobs.json
# The core's local tools (notes, timers) write here.
sidekick_runtime/
.sidekick_runtime/

# Local audit runs and eval outputs (machine specific paths)
reports/

# Internal dev/handoff docs -- not part of the public repo
docs/handoff/
docs/AI_HANDOFF.md
docs/CAPABILITY_REALITY_AUDIT.md
docs/DECISION_FAILURES.md
docs/HACKATHON_COMPLIANCE.md
docs/IMPLEMENTATION_PLAN.md
docs/PROJECT_AUDIT.md
docs/execution-prerequisites-audit.md

# Python packaging artifacts
sidekick.egg-info/
