# Sidekick Environment Variables Reference
# All values are placeholders only. Never commit real secrets, API keys, or machine-specific paths.

# ==============================================================================
# 1. CORE BRAIN & DECISION ENGINE
# ==============================================================================
# Model selection: auto | laya | bedrock | rule
SIDEKICK_DECISION_MODEL=auto

# Optional override for Laya checkpoint (defaults to convaiinnovations/laya)
# SIDEKICK_LAYA_CHECKPOINT=convaiinnovations/laya
# LAYA_PRELOAD=0

# Runtime workspace directory for local notes and files
SIDEKICK_WORKSPACE=./sidekick_runtime

# Logging level (debug | info | warning | error)
LOG_LEVEL=info

# ==============================================================================
# 2. AWS & AMAZON BEDROCK
# ==============================================================================
# AWS credentials and region for Bedrock decision routing
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ==============================================================================
# 3. ALEXA INTEGRATION
# ==============================================================================
# Optional Alexa Skill ID to validate incoming ASK requests
# ALEXA_SKILL_ID=amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ==============================================================================
# 4. CODING EXECUTION SERVICE
# ==============================================================================
# URL pointing the core brain at the execution service (if running separately)
# SIDEKICK_EXECUTION_URL=http://127.0.0.1:8088

# Provider choice: auto | http_api | local_cli | simulated
SIDEKICK_PROVIDER=auto

# Remote coding provider (OpenAI-compatible endpoint, e.g. Claude Code proxy or OpenAI)
# SIDEKICK_LLM_API_KEY=
# SIDEKICK_LLM_BASE_URL=https://api.openai.com/v1
# SIDEKICK_LLM_MODEL=gpt-4o
# SIDEKICK_LLM_TIMEOUT=60.0

# Local authorized coding CLI (e.g. cursor-agent or claude-cli)
# SIDEKICK_CODING_CLI=
# SIDEKICK_CODING_CLI_ARGS=
# SIDEKICK_CODING_CLI_TIMEOUT=120.0

# ==============================================================================
# 5. WEB CLIENT & MOVIE BUDDY (Vite)
# ==============================================================================
# Target backend URL for local frontend development proxy
# SIDECKICK_API_TARGET=http://127.0.0.1:8000

# Optional remote commentary provider for Movie Buddy (browser-side)
# VITE_SIDECKICK_COMMENTARY_ENDPOINT=
# VITE_SIDECKICK_COMMENTARY_MODEL=
# VITE_SIDECKICK_COMMENTARY_API_KEY=